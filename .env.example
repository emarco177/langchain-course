# OpenAI — the chat models behind every example.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# LangSmith — optional tracing. 02 prints a trace link when this is on.
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=agent-middleware
# Non-US region? Uncomment your endpoint:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com    # GCP EU
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com  # GCP APAC
