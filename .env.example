# TypeSafe — the Jev model used by every example. Get a key at
# https://console.typesafe.ai/keys
TYPESAFE_API_KEY=your-typesafe-api-key

# OpenAI — the chat models routed to / gated by the middleware examples (05, 06).
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# LangSmith — optional tracing and observability. Uncomment to trace runs.
# Jev calls show up as LLM runs with provider "typesafe" and their token usage.
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=system-one-models
# Non-US region? Uncomment your endpoint:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com    # GCP EU
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com  # GCP APAC
