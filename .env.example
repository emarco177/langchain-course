# TypeSafe — Jev, the model under test. Get a key at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=your-typesafe-api-key
# Pin the Jev version you evaluate. `jev-latest` moves (1.13.0 → 1.14.0 on Oct 24, 2026).
# JEV_MODEL=jev-1.14.0

# LangSmith — datasets and experiments (02, 03, 06, 07, 08). Required on this branch.
LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=evaluating-jev
# Non-US region? Uncomment your endpoint:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com    # GCP EU
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com  # GCP APAC

# OpenAI — the agent in 00, and one LLM baseline in 06.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
