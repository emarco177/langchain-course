# OpenAI — the chat model behind 02 and 03. 01, 05 and check.py need no key.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# Everything below is optional. The defaults live in settings.py.

# The MCP server every lesson talks to. Change it here and nowhere else.
# MCP_URL=https://docs.langchain.com/mcp
# Hosted server down or moved? Run `uv run python 05_docs_server.py` and use:
# MCP_URL=http://localhost:8000/mcp

# Any LangChain model string works, e.g. anthropic:..., google_genai:...
# MODEL=openai:gpt-6-luna

# LangSmith — optional tracing.
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=mcp-lessons
